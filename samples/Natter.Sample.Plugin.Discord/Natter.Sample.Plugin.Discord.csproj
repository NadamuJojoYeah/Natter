<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Natter.Sample.Plugin.Discord</RootNamespace>
    <AssemblyName>Natter.Sample.Plugin.Discord</AssemblyName>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Natter.Chat.Discord/Natter.Chat.Discord.csproj" />
    <ProjectReference Include="../../src/Natter.Plugin.Abstractions/Natter.Plugin.Abstractions.csproj" />
    <ProjectReference Include="../../src/Natter.Cli.Abstractions/Natter.Cli.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="plugin.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="config.schema.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="plugin.json" LogicalName="Natter.Sample.Plugin.Discord.plugin.json" />
    <EmbeddedResource Include="config.schema.json" LogicalName="Natter.Sample.Plugin.Discord.config.schema.json" />
  </ItemGroup>

  <Target Name="StageDiscordPlugin" AfterTargets="Build">
    <ItemGroup>
      <DiscordPluginRuntime Include="$(TargetPath)" />
      <DiscordPluginRuntime Include="@(ReferenceCopyLocalPaths)" />
    </ItemGroup>
    <Copy SourceFiles="@(DiscordPluginRuntime)" DestinationFolder="$(OutDir)lib" SkipUnchangedFiles="true" />
  </Target>

</Project>
