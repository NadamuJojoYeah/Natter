{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["token", "selfId"],
  "additionalProperties": false,
  "properties": {
    "token": {
      "type": "string",
      "pattern": "^\\$\\{secret:DISCORD_BOT_TOKEN\\}$",
      "description": "Secret reference only; the bot token must come from IPluginSecrets."
    },
    "selfId": {
      "type": "string",
      "pattern": "^[0-9]+$",
      "description": "Discord bot user id used to build Source before login."
    },
    "intents": {
      "type": "array",
      "items": {
        "enum": ["Guilds", "GuildMessages", "DirectMessages", "MessageContent", "GuildMembers", "GuildPresences", "GuildMessageReactions"]
      },
      "uniqueItems": true
    },
    "guilds": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]+$" }, "uniqueItems": true },
    "channels": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]+$" }, "uniqueItems": true },
    "users": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]+$" }, "uniqueItems": true },
    "requireMention": { "type": "boolean" },
    "messageCommands": { "type": "boolean" },
    "slashCommands": { "type": "boolean" },
    "ignoreBots": {
      "type": "boolean",
      "description": "Default true. Disabling lets bot messages enter NLMP; keep true unless another layer filters them."
    },
    "ignoreSelf": {
      "type": "boolean",
      "description": "Default true. Disabling can make the bot answer its own messages; orchestrator also ignores self by default."
    },
    "typing": { "type": "boolean" },
    "maxMessageLength": { "type": "integer", "minimum": 1, "maximum": 2000 },
    "maxAttachmentBytes": { "type": "integer", "minimum": 1 },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ask": { "type": "boolean" },
        "remember": { "type": "boolean" },
        "forget": { "type": "boolean" },
        "memory": { "type": "boolean" },
        "reset": { "type": "boolean" },
        "task": { "type": "boolean" },
        "status": { "type": "boolean" },
        "tasks": { "type": "boolean" },
        "cancel": { "type": "boolean" }
      }
    },
    "interactionTtlSeconds": { "type": "integer", "minimum": 1, "maximum": 900 },
    "readyTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 300 },
    "reconnectWatchdog": {
      "type": "boolean",
      "description": "Default true. Rebuild the gateway transport when connected stays false past the threshold."
    },
    "reconnectWatchdogThresholdMs": {
      "type": "integer",
      "minimum": 5000,
      "maximum": 600000,
      "description": "Default 60000. Tolerated disconnected window before the watchdog rebuilds."
    },
    "reconnectWatchdogTickMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 60000,
      "description": "Default 0 (auto: threshold/4 clamped). Watchdog poll interval."
    },
    "reconnectBackoffInitialMs": {
      "type": "integer",
      "minimum": 100,
      "maximum": 60000,
      "description": "Default 1000. First retry delay after a failed rebuild."
    },
    "reconnectBackoffMaxMs": {
      "type": "integer",
      "minimum": 100,
      "maximum": 600000,
      "description": "Default 60000. Upper bound for the exponential backoff."
    },
    "reconnectMaxAttempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "description": "Default 10. After this many failed rebuilds the watchdog stops and flags manual intervention."
    },
    "devGuildId": { "type": "string", "pattern": "^[0-9]+$" }
  }
}
