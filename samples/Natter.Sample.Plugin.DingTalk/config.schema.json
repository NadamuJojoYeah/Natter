{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["clientId", "clientSecret", "botId"],
  "additionalProperties": false,
  "properties": {
    "clientId": { "type": "string", "minLength": 1 },
    "clientSecret": {
      "type": "string",
      "pattern": "^\\$\\{secret:DINGTALK_CLIENT_SECRET\\}$",
      "description": "Secret reference only; the Stream client secret comes from IPluginSecrets."
    },
    "botId": { "type": "string", "minLength": 1 },
    "robotCode": { "type": "string" },
    "streamGatewayUrl": { "type": "string", "pattern": "^https?://" },
    "streamTopic": { "type": "string" },
    "reconnectBaseDelayMs": { "type": "integer", "minimum": 0, "maximum": 60000 },
    "reconnectMaxDelayMs": { "type": "integer", "minimum": 0, "maximum": 300000 },
    "maxClockSkewMinutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
    "requireMention": { "type": "boolean" },
    "conversations": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "users": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "maxMessageLength": { "type": "integer", "minimum": 1, "maximum": 20000 },
    "streamIdleTimeoutMs": {
      "type": "integer",
      "minimum": 10000,
      "maximum": 600000,
      "description": "Default 90000. No inbound frame for this long means the stream is half-open and gets reconnected."
    },
    "streamPongTimeoutMs": {
      "type": "integer",
      "minimum": 5000,
      "maximum": 300000,
      "description": "Default 30000. Allowed gap after an ack before the stream is considered silent."
    },
    "streamCallbackDedupCapacity": {
      "type": "integer",
      "minimum": 16,
      "maximum": 100000,
      "description": "Default 2048. Bounded set of recently acknowledged callback ids."
    },
    "streamCallbackDedupTtlMs": {
      "type": "integer",
      "minimum": 60000,
      "maximum": 3600000,
      "description": "Default 600000. How long a callback id stays deduplicated (platform replay window is 60 min)."
    }
  }
}
