<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Natter.Plugin.StateVitals.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The state-directory test mutates NATTER_STATE_DIR, so collections must not run in parallel. -->
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <None Remove="plugin-package/**" />
    <Content Remove="plugin-package/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../plugins/Natter.Plugin.StateVitals/Natter.Plugin.StateVitals.csproj" />
    <ProjectReference Include="../../src/Natter.Infrastructure/Natter.Infrastructure.csproj" />
    <ProjectReference Include="../../src/Natter.Cli.Core/Natter.Cli.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Package layout read by the manifest/config and NPS staging tests. -->
    <None Include="../../plugins/Natter.Plugin.StateVitals/plugin.json"
          Link="plugin-package/plugin.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../plugins/Natter.Plugin.StateVitals/config.schema.json"
          Link="plugin-package/config.schema.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../plugins/Natter.Plugin.StateVitals/config.sample.json"
          Link="plugin-package/config.sample.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../plugins/Natter.Plugin.StateVitals/definitions/**"
          Link="plugin-package/definitions/%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
