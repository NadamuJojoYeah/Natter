# Template for the opt-in live integration tests.
# Preferred location (outside the repo):
#   mkdir -p ~/.config/natter
#   cp tests/Natter.Live.Tests/.env.example ~/.config/natter/live.env
#   chmod 600 ~/.config/natter/live.env
# Legacy location (git-ignored, still supported as fallback):
#   artifacts/live/.env
# Override with NATTER_LIVE_ENV=/path/to/file if needed.
#
# The tests run only when NATTER_LIVE=1 is set (scripts/live-test.sh does that for you).
# Never commit this file with real values, never paste keys into logs or test output.

DEEPSEEK_API_KEY=sk-replace-me
DISCORD_BOT_TOKEN=replace-me

# Discord test target. The bot needs View Channel, Send Messages, Read Message History,
# Embed Links and Attach Files in this channel. Tests create and delete their own messages.
DISCORD_TEST_GUILD_ID=000000000000000000
DISCORD_TEST_CHANNEL_ID=000000000000000000
DISCORD_BOT_USER_ID=000000000000000000

# DingTalk Stream transport (natter.transport.messaging.dingtalk)
DINGTALK_CLIENT_ID=replace-me
DINGTALK_CLIENT_SECRET=replace-me
DINGTALK_BOT_ID=replace-me

# iFlytek Spark MaaS (natter.feature.ai.spark)
SPARK_API_KEY=ak-replace-me

# Optional: manual gate (scripts/live-test.sh manual) waits for a human to mention the bot.
# NATTER_LIVE_MANUAL=1
