{
  "name": "natter-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Natter console front-ends (webconsole + conversation). Built locally, never committed.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "npm run build:webconsole && npm run build:conversation",
    "build:webconsole": "vite build --mode webconsole",
    "build:conversation": "vite build --mode conversation",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev:webconsole": "vite --mode webconsole"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "antd": "^6.7.2",
    "echarts": "^6.1.0",
    "react": "^19.1.10",
    "react-dom": "^19.1.10"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "@types/node": "^24.10.0"
  }
}
