[Unit]
Description=Natter Tier 1 chat host (Discord + DeepSeek)
Documentation=https://github.com/NadamuJojoYeah/Natter/blob/main/docs/OPERATIONS_RUNBOOK.md
After=network-online.target
Wants=network-online.target
# Keep restarts from turning into a storm during a gateway/proxy outage.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# The bot token may only ever run once per host: one bot token == one `serve` process.
User=natter
Group=natter
WorkingDirectory=/opt/natter

# Secrets come from live.env (0600). Egress proxy settings are optional and kept in a separate
# file so that secrets and network config never mix; the '-' prefix makes it optional.
EnvironmentFile=/etc/natter/live.env
EnvironmentFile=-/etc/natter/proxy.env
Environment=NATTER_CONFIG_DIR=/etc/natter/config
Environment=NATTER_STATE_DIR=/var/lib/natter
# Loopback-only health endpoint used by runbook sampling and scripts/soak-sample.sh.
Environment=NATTER_HEALTH_PORT=5099

ExecStart=/opt/natter/natter serve --health-port 5099

Restart=on-failure
RestartSec=5
# serve handles SIGTERM and closes the SQLite WAL cleanly; give it time before SIGKILL.
KillSignal=SIGTERM
KillMode=control-group
TimeoutStopSec=20

# --- hardening ---------------------------------------------------------------
# Plugin-owned data lives in the plugin directory so "uninstall = delete the directory". The code
# itself stays root-owned and read-only; only the `audit` subdirectory of a writing plugin is carved
# out below. `update-release.sh` hands exactly those directories to User=/Group=.
#
# ReadWritePaths does not glob, so each writing plugin needs an explicit line. Prefix with `-` so a
# plugin that is not installed in this release does not make the unit fail to start.
StateDirectory=natter
LogsDirectory=natter
StateDirectoryMode=0700
LogsDirectoryMode=0700
ReadWritePaths=/var/lib/natter /var/log/natter \
               -/opt/natter/plugins/natter.tool.admin.webconsole/audit \
               -/opt/natter/plugins/natter.tool.conversation.conversation-console/audit
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
# NOTE: do not add MemoryDenyWriteExecute=yes — the .NET JIT needs W^X and the host will crash.
UMask=0077
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
