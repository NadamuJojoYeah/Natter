{
  "$schema": "./profiles.schema.json",
  "schemaVersion": 1,
  "defaultProfile": "tier1-default",
  "profiles": [
    {
      "id": "tier1-default",
      "supportTier": 1,
      "match": {
        "protocols": ["discord"],
        "platforms": ["discord"],
        "guilds": [],
        "conversations": [],
        "actors": []
      },
      "ai": {
        "provider": "natter.feature.ai.deepseek#deepseek",
        "model": "deepseek-flash"
      },
      "prompt": {
        "provider": "host#static",
        "version": "default",
        "systemPrompt": "You are Natter, a concise assistant."
      },
      "context": {
        "assembler": "host#recent-window",
        "maxInputCharacters": 12000,
        "maxMemoryItems": 8,
        "maxSummaryCharacters": 1200
      },
      "memory": {
        "store": "host#sqlite",
        "retriever": "host#recent",
        "extractor": "host#explicit"
      },
      "history": {
        "scope": "conversation",
        "maxMessages": 20,
        "maxCharacters": 24000
      },
      "policy": {
        "enabled": true
      }
    },
    {
      "id": "tier2-dingtalk-spark",
      "supportTier": 2,
      "match": {
        "protocols": ["dingtalk"],
        "platforms": ["dingtalk"],
        "guilds": [],
        "conversations": [],
        "actors": []
      },
      "ai": {
        "provider": "natter.feature.ai.spark#spark",
        "model": "spark-x2.5-1.7b"
      },
      "prompt": {
        "provider": "host#static",
        "version": "default",
        "systemPrompt": "You are Natter, a concise assistant."
      },
      "context": {
        "assembler": "host#recent-window",
        "maxInputCharacters": 12000,
        "maxMemoryItems": 8,
        "maxSummaryCharacters": 1200
      },
      "memory": {
        "store": "host#sqlite",
        "retriever": "host#recent",
        "extractor": "host#explicit"
      },
      "history": {
        "scope": "conversation",
        "maxMessages": 20,
        "maxCharacters": 24000
      },
      "policy": {
        "enabled": true
      }
    }
  ]
}
