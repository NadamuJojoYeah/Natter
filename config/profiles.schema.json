{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "defaultProfile", "profiles"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "defaultProfile": { "type": "string", "minLength": 1 },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "supportTier", "match", "ai"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "supportTier": { "type": "integer", "enum": [1, 2] },
          "match": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "protocols": { "type": "array", "items": { "type": "string" } },
              "platforms": { "type": "array", "items": { "type": "string" } },
              "guilds": { "type": "array", "items": { "type": "string" } },
              "conversations": { "type": "array", "items": { "type": "string" } },
              "actors": { "type": "array", "items": { "type": "string" } }
            }
          },
          "ai": {
            "type": "object",
            "required": ["provider"],
            "additionalProperties": false,
            "properties": {
              "provider": { "type": "string", "pattern": "^[^#]+#[^#]+$" },
              "model": { "type": "string" }
            }
          },
          "prompt": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "provider": { "type": "string", "pattern": "^[^#]+#[^#]+$" },
              "version": { "type": "string" },
              "systemPrompt": { "type": "string" }
            }
          },
          "context": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "assembler": { "type": "string", "pattern": "^[^#]+#[^#]+$" },
              "maxInputCharacters": { "type": "integer", "minimum": 1 },
              "maxMemoryItems": { "type": "integer", "minimum": 0 },
              "maxSummaryCharacters": { "type": "integer", "minimum": 0 },
              "maxRecentMessages": { "type": "integer", "minimum": 0 },
              "maxRecentCharacters": { "type": "integer", "minimum": 0 }
            }
          },
          "memory": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "store": { "type": "string", "pattern": "^[^#]+#[^#]+$" },
              "retriever": { "type": "string" },
              "extractor": { "type": "string" }
            }
          },
          "history": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "scope": { "type": "string", "enum": ["conversation", "user"] },
              "maxMessages": { "type": "integer", "minimum": 1, "maximum": 200 },
              "maxCharacters": { "type": "integer", "minimum": 1, "maximum": 200000 }
            }
          },
          "policy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": { "type": "boolean" },
              "allowNetworkTools": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
