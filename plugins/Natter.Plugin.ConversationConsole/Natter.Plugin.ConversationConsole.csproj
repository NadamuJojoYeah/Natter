<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Natter.Plugin.ConversationConsole</RootNamespace>
    <AssemblyName>Natter.Plugin.ConversationConsole</AssemblyName>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <IsPackable>false</IsPackable>
    <Description>Natter Conversation Console plugin: read-only conversation replay (list, filter, search, message paging) over the host IConversationQuery port.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Natter.Plugin.Abstractions/Natter.Plugin.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="plugin.json" LogicalName="Natter.Plugin.ConversationConsole.plugin.json" />
    <None Update="plugin.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="config.schema.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="config.sample.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="wwwroot/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
