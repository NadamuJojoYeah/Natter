{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Natter Conversation Console config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "token"
  ],
  "properties": {
    "bind": {
      "type": "string",
      "default": "127.0.0.1",
      "pattern": "^(127(\\.[0-9]{1,3}){3}|::1|localhost)$"
    },
    "port": {
      "type": "integer",
      "default": 5091,
      "minimum": 1,
      "maximum": 65535
    },
    "token": {
      "type": "string",
      "default": "${secret:CONVERSATION_CONSOLE_TOKEN}",
      "enum": [
        "${secret:CONVERSATION_CONSOLE_TOKEN}"
      ]
    },
    "readOnly": {
      "type": "boolean",
      "default": true
    },
    "pageSize": {
      "type": "integer",
      "default": 25,
      "minimum": 1,
      "maximum": 200
    },
    "messagePageSize": {
      "type": "integer",
      "default": 50,
      "minimum": 1,
      "maximum": 200
    },
    "requestTimeoutSeconds": {
      "type": "integer",
      "default": 15,
      "minimum": 1,
      "maximum": 120
    },
    "maxConcurrentRequests": {
      "type": "integer",
      "default": 16,
      "minimum": 1,
      "maximum": 128
    },
    "auditRetentionFiles": {
      "type": "integer",
      "default": 3,
      "minimum": 3,
      "maximum": 20
    }
  }
}
