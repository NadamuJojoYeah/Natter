<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Natter.Plugin.WebConsole</RootNamespace>
    <AssemblyName>Natter.Plugin.WebConsole</AssemblyName>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <NpsPlugin>true</NpsPlugin>
    <IsPackable>false</IsPackable>
    <Description>Natter WebConsole plugin: loopback read-only diagnostics, config preview and restricted command console.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Natter.Plugin.Abstractions/Natter.Plugin.Abstractions.csproj" />
    <ProjectReference Include="../../src/Natter.Cli.Abstractions/Natter.Cli.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="plugin.json" LogicalName="Natter.Plugin.WebConsole.plugin.json" />
    <None Update="plugin.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="config.schema.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="config.sample.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="wwwroot/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>


  <!--
    UI build (task-62). The front-end lives in ui/ and its output *is* wwwroot, which is git-ignored:
    a plugin package without it is broken, so `dotnet publish` must build it too.

      dotnet build  -p:SkipUiBuild=true    pure back-end loop (warns: the package has no UI)
  -->
  <ItemGroup>
    <UiSource Include="$(MSBuildThisFileDirectory)../../ui/src/**" />
    <UiSource Include="$(MSBuildThisFileDirectory)../../ui/package.json" />
    <UiSource Include="$(MSBuildThisFileDirectory)../../ui/package-lock.json" />
    <UiSource Include="$(MSBuildThisFileDirectory)../../ui/vite.config.ts" />
    <UiSource Include="$(MSBuildThisFileDirectory)../../ui/tsconfig.json" />
  </ItemGroup>

  <Target Name="BuildWebUi" BeforeTargets="PrepareForBuild;AssignTargetPaths"
          Condition="'$(SkipUiBuild)' != 'true'"
          Inputs="@(UiSource)"
          Outputs="$(MSBuildThisFileDirectory)wwwroot/index.html">
    <PropertyGroup>
      <UiDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../ui/'))</UiDirectory>
      <UiHasVite>$([System.IO.Directory]::Exists('$(UiDirectory)node_modules/.bin/vite'))</UiHasVite>
    </PropertyGroup>

    <Error Condition="!Exists('$(UiDirectory)package.json')"
           Text="UI workspace not found at '$(UiDirectory)'; the plugin needs ui/ to build its wwwroot." />

    <!-- Dependency install is keyed on the vite shim: a partial node_modules still gets repaired.
         RemoveDir first: npm's own `ci` cleanup hits ENOTEMPTY on overlay filesystems. -->
    <RemoveDir Directories="$(UiDirectory)node_modules" Condition="'$(UiHasVite)' != 'True'" />
    <Exec Command="npm ci --no-audit --no-fund"
          WorkingDirectory="$(UiDirectory)"
          Condition="'$(UiHasVite)' != 'True'"
          StandardOutputImportance="normal" />
    <Exec Command="npm run build:webconsole" WorkingDirectory="$(UiDirectory)" />

    <ItemGroup>
      <None Include="$(MSBuildThisFileDirectory)wwwroot/**"
            Exclude="@(None)"
            CopyToOutputDirectory="PreserveNewest"
            CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <Target Name="WarnMissingWebUi" BeforeTargets="PrepareForBuild" Condition="'$(SkipUiBuild)' == 'true'">
    <Warning Text="SkipUiBuild=true: plugin $(AssemblyName) is packaged WITHOUT a UI (wwwroot not built). Deployment gates must reject such a package; never publish it." />
  </Target>

  <Import Project="$(MSBuildThisFileDirectory)../../build/Natter.Plugin.targets" />

</Project>
