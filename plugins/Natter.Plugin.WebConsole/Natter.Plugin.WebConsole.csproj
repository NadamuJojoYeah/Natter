<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Natter.Plugin.WebConsole</RootNamespace>
    <AssemblyName>Natter.Plugin.WebConsole</AssemblyName>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <NpsPlugin>true</NpsPlugin>
    <IsPackable>false</IsPackable>
    <Description>Natter WebConsole plugin: loopback read-only diagnostics, config preview and restricted command console.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Natter.Plugin.Abstractions/Natter.Plugin.Abstractions.csproj" />
    <ProjectReference Include="../../src/Natter.Cli.Abstractions/Natter.Cli.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="plugin.json" LogicalName="Natter.Plugin.WebConsole.plugin.json" />
    <None Update="plugin.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="config.schema.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="config.sample.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="wwwroot/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Import Project="$(MSBuildThisFileDirectory)../../build/Natter.Plugin.targets" />

</Project>
