{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["apiKey"],
  "additionalProperties": false,
  "properties": {
    "apiKey": {
      "type": "string",
      "pattern": "^\\$\\{secret:DEEPSEEK_API_KEY\\}$",
      "description": "Secret reference only; the key comes from IPluginSecrets."
    },
    "baseUrl": { "default": "https://api.deepseek.com", "type": "string", "pattern": "^https?://" },
    "model": { "default": "deepseek-flash", "type": "string", "minLength": 1 },
    "thinking": { "default": "disabled", "type": "string", "enum": ["disabled", "enabled"] },
    "reasoningEffort": { "default": "none", "type": "string", "enum": ["none", "low", "high", "max"] },
    "systemPrompt": { "default": "You are Natter, a concise Discord assistant.", "type": "string" },
    "temperature": { "default": 0.7, "type": "number", "minimum": 0, "maximum": 2 },
    "maxOutputTokens": { "type": "integer", "minimum": 1, "maximum": 384000, "default": 4096 },
    "maxInputCharacters": { "default": 12000, "type": "integer", "minimum": 1 },
    "historyMaxMessages": { "default": 20, "type": "integer", "minimum": 0, "maximum": 1000 },
    "historyMaxCharacters": { "default": 24000, "type": "integer", "minimum": 0, "maximum": 1000000 },
    "timeoutSeconds": { "default": 60, "type": "integer", "minimum": 1, "maximum": 600 },
    "maxRetries": { "default": 2, "type": "integer", "minimum": 0, "maximum": 5 },
    "retryBaseDelayMs": { "default": 250, "type": "integer", "minimum": 0, "maximum": 60000 },
    "retryMaxDelayMs": { "default": 2000, "type": "integer", "minimum": 0, "maximum": 60000 },
    "streaming": { "default": false, "type": "boolean" },
    "tools": { "default": [], "type": "array", "items": { "type": "string" }, "maxItems": 0 },
    "historyScope": { "default": "conversation", "type": "string", "enum": ["conversation", "user"] },
    "maxConcurrentRequests": { "default": 2, "type": "integer", "minimum": 1, "maximum": 16 },
    "fallbackText": { "default": "AI is temporarily unavailable. Please try again shortly.", "type": "string" },
    "emptyResponseText": { "default": "I could not produce a response.", "type": "string" }
  }
}
