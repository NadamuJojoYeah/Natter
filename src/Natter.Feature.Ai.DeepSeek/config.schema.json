{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["apiKey"],
  "additionalProperties": false,
  "properties": {
    "apiKey": {
      "type": "string",
      "pattern": "^\\$\\{secret:DEEPSEEK_API_KEY\\}$",
      "description": "Secret reference only; the key comes from IPluginSecrets."
    },
    "baseUrl": { "type": "string", "pattern": "^https?://" },
    "model": { "type": "string", "minLength": 1 },
    "thinking": { "type": "string", "enum": ["disabled", "enabled"] },
    "reasoningEffort": { "type": "string", "enum": ["none", "low", "high", "max"] },
    "systemPrompt": { "type": "string" },
    "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
    "maxOutputTokens": { "type": "integer", "minimum": 1, "maximum": 384000 },
    "maxInputCharacters": { "type": "integer", "minimum": 1 },
    "historyMaxMessages": { "type": "integer", "minimum": 0, "maximum": 1000 },
    "historyMaxCharacters": { "type": "integer", "minimum": 0, "maximum": 1000000 },
    "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 600 },
    "streaming": { "type": "boolean" },
    "tools": { "type": "array", "items": { "type": "string" }, "maxItems": 0 },
    "historyScope": { "type": "string", "enum": ["conversation", "user"] },
    "maxConcurrentRequests": { "type": "integer", "minimum": 1, "maximum": 16 },
    "fallbackText": { "type": "string" },
    "emptyResponseText": { "type": "string" }
  }
}
