<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Natter.Hosting.Android</RootNamespace>
    <AssemblyName>Natter.Hosting.Android</AssemblyName>

    <ApplicationId>dev.natter.hosting.android</ApplicationId>
    <ApplicationTitle>Natter CLI</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidLinkMode>None</AndroidLinkMode>
    <NatterPluginMode Condition="'$(NatterPluginMode)' == ''">embedded</NatterPluginMode>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'DynamicPlugins'">
    <NatterPluginMode>dynamic</NatterPluginMode>
  </PropertyGroup>

  <PropertyGroup Condition="'$(NatterPluginMode)' == 'dynamic'">
    <DefineConstants>$(DefineConstants);NATTER_DYNAMIC_PLUGINS</DefineConstants>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <PublishTrimmed>false</PublishTrimmed>
    <AndroidLinkMode>None</AndroidLinkMode>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="trusted-keys.txt" LogicalName="Natter.Hosting.Android.trusted-keys.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Natter.Cli.Core/Natter.Cli.Core.csproj" />
    <ProjectReference Include="../Natter.Cli.Abstractions/Natter.Cli.Abstractions.csproj" />
    <ProjectReference Include="../Natter.Plugin.Store/Natter.Plugin.Store.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(NatterPluginMode)' != 'dynamic'">
    <ProjectReference Include="../../samples/Natter.Sample.Plugin.Greetings/Natter.Sample.Plugin.Greetings.csproj" />
    <ProjectReference Include="../../samples/Natter.Sample.Plugin.Metrics/Natter.Sample.Plugin.Metrics.csproj" />
  </ItemGroup>

</Project>
